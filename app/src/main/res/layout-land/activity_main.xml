<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context=".MainActivity">

    <!-- Baris atas: tombol-tombol implicit intent -->
    <Button
        android:id="@+id/button_browser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#3DCE0C"
        android:text="@string/button_label_browser"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        app:cornerRadius="20dp" />

    <Button
        android:id="@+id/button_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF6F00"
        android:text="@string/button_label_contact"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/button_browser"
        android:layout_marginLeft="12dp"
        app:cornerRadius="20dp" />

    <Button
        android:id="@+id/button_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#C62828"
        android:text="@string/button_label_map"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@id/button_contact"
        android:layout_marginLeft="12dp"
        app:cornerRadius="20dp" />

    <!-- Tombol Toast di bawah baris tombol implicit -->
    <Button
        android:id="@+id/button_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_toast"
        android:layout_below="@id/button_browser"
        android:layout_alignParentStart="true"
        android:layout_marginTop="12dp"
        app:cornerRadius="20dp" />

    <!-- Tombol Count di sebelah kanan Button Toast -->
    <Button
        android:id="@+id/button_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_count"
        android:layout_below="@id/button_browser"
        android:layout_toRightOf="@id/button_toast"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="12dp"
        app:cornerRadius="20dp" />

    <!-- Tombol Switch Page di sebelah kanan Button Count -->
    <Button
        android:id="@+id/button_switchpage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_pindah"
        android:layout_below="@id/button_browser"
        android:layout_toRightOf="@id/button_count"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="12dp"
        app:cornerRadius="20dp" />

    <!-- TextView penampil angka -->
    <TextView
        android:id="@+id/show_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFF00"
        android:gravity="center"
        android:text="@string/count_initial_value"
        android:textSize="100sp"
        android:layout_below="@id/button_toast"
        android:layout_marginTop="16dp" />

</RelativeLayout>
